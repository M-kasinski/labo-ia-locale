---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
const radarPosts = allPosts.filter((post) => post.data.tags.includes('radar-ia')).slice(0, 3);
const posts = allPosts.slice(0, 5);

const featured = posts[0];
const secondaryPosts = posts.slice(1);
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow">IA open-source, en local, sans fumée</p>
					<h1 id="hero-title">Comprendre l’IA locale avant d’empiler les GPUs.</h1>
					<p class="lede">{SITE_DESCRIPTION}</p>
					<div class="hero-actions">
						<a class="button" href="/blog/">Lire les articles</a>
						<a class="button-secondary" href="/about/">Notre ligne éditoriale</a>
					</div>
				</div>
				<aside class="terminal-card" aria-label="Résumé des sujets couverts">
					<div class="terminal-top"><span></span><span></span><span></span></div>
					<pre><code>$ labo --focus
local-llm
quantization
self-hosting
apple-silicon
gpu-serving
sources: required</code></pre>
				</aside>
			</section>

			<section class="pillars" aria-labelledby="pillars-title">
				<p class="eyebrow">Le terrain</p>
				<h2 id="pillars-title">Des choix techniques, pas des slogans.</h2>
				<div class="pillar-grid">
					<article class="card pillar">
						<h3>Modèles & licences</h3>
						<p>Comprendre ce que l’on peut télécharger, modifier, servir et utiliser sans se raconter d’histoires.</p>
					</article>
					<article class="card pillar">
						<h3>Runtimes & matériel</h3>
						<p>Comparer llama.cpp, Ollama, vLLM, MLX, GPU NVIDIA, AMD et mémoire unifiée Apple.</p>
					</article>
					<article class="card pillar">
						<h3>Guides sourcés</h3>
						<p>Chaque article vise une décision concrète, avec sources en bas de page et limites explicites.</p>
					</article>
				</div>
			</section>


			{radarPosts.length > 0 && (
				<section class="radar" aria-labelledby="radar-title">
					<div class="section-heading">
						<p class="eyebrow">Radar IA</p>
						<h2 id="radar-title">Signaux courts à surveiller</h2>
						<p>Des brèves sourcées pour capter les annonces, rumeurs crédibles et mouvements de marché avant d'en faire un décryptage complet.</p>
					</div>
					<div class="radar-grid">
						{radarPosts.map((post) => (
							<article class="radar-card">
								<a href={`/blog/${post.id}/`}>
									<span class="radar-badge">Signal faible</span>
									<span class="radar-date"><FormattedDate date={post.data.pubDate} /></span>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</article>
						))}
					</div>
				</section>
			)}

			{featured && (
				<section class="latest" aria-labelledby="latest-title">
					<div class="section-heading">
						<p class="eyebrow">À lire maintenant</p>
						<h2 id="latest-title">Derniers articles</h2>
					</div>
					<div class="latest-layout">
						<article class="featured-card">
							<a href={`/blog/${featured.id}/`}>
								<span><FormattedDate date={featured.data.pubDate} /></span>
								<h3>{featured.data.title}</h3>
								<p>{featured.data.description}</p>
							</a>
						</article>
						<ul class="compact-list">
							{secondaryPosts.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span><FormattedDate date={post.data.pubDate} /></span>
										<strong>{post.data.title}</strong>
									</a>
								</li>
							))}
						</ul>
					</div>
				</section>
			)}
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: min(var(--container), calc(100% - 2rem));
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 4rem);
		padding: clamp(2.5rem, 7vw, 6rem) 0 3rem;
	}

	.hero h1 {
		max-width: 900px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.6rem;
	}

	.terminal-card {
		border: 1px solid #263244;
		border-radius: var(--radius-lg);
		background: #111827;
		box-shadow: var(--shadow-soft);
		overflow: hidden;
	}

	.terminal-top {
		display: flex;
		gap: 0.45rem;
		border-bottom: 1px solid #263244;
		padding: 0.8rem 1rem;
	}

	.terminal-top span {
		width: 0.72rem;
		height: 0.72rem;
		border-radius: 999px;
		background: #8ee6d4;
		opacity: 0.78;
	}

	.terminal-top span:nth-child(2) {
		background: #f2c078;
	}

	.terminal-top span:nth-child(3) {
		background: #df8d8d;
	}

	.terminal-card pre {
		margin: 0;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.pillars,
	.radar,
	.latest {
		margin-top: clamp(2.5rem, 7vw, 5rem);
	}

	.pillars > h2 {
		max-width: 720px;
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.pillar {
		padding: 1.25rem;
	}

	.pillar h3 {
		font-size: 1.25rem;
	}

	.pillar p {
		margin-bottom: 0;
		color: var(--text-muted);
		font-size: 0.98rem;
	}

	.section-heading {
		margin-bottom: 1.5rem;
	}


	.section-heading p:not(.eyebrow) {
		max-width: 760px;
		margin-top: 0.45rem;
		color: var(--text-muted);
	}

	.radar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.radar-card {
		border: 1px solid color-mix(in srgb, var(--accent) 52%, var(--border));
		border-radius: var(--radius-lg);
		background:
			linear-gradient(135deg, rgba(242, 192, 120, 0.2), transparent 48%),
			color-mix(in srgb, var(--surface) 90%, transparent);
		box-shadow: 0 14px 35px rgba(31, 28, 21, 0.055);
		padding: 1.15rem;
	}

	.radar-card a {
		color: inherit;
		text-decoration: none;
	}

	.radar-badge,
	.radar-date {
		display: inline-flex;
		margin: 0 0.55rem 0.75rem 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 780;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.radar-badge {
		border-radius: 999px;
		background: #111827;
		color: #f7e1b8;
		padding: 0.28rem 0.55rem;
	}

	.radar-date {
		color: var(--accent-dark);
	}

	.radar-card h3 {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
	}

	.radar-card p {
		color: var(--text-muted);
	}

	.latest-layout {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(320px, 0.95fr);
		gap: 1rem;
	}

	.featured-card,
	.compact-list li {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--surface) 88%, transparent);
	}

	.featured-card {
		padding: clamp(1.4rem, 4vw, 2rem);
		background:
			linear-gradient(135deg, rgba(216, 243, 238, 0.72), transparent 60%),
			var(--surface);
	}

	.featured-card a,
	.compact-list a {
		color: inherit;
		text-decoration: none;
	}

	.featured-card span,
	.compact-list span {
		display: inline-block;
		margin-bottom: 0.65rem;
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 760;
	}

	.featured-card h3 {
		font-size: clamp(1.7rem, 4vw, 2.7rem);
	}

	.featured-card p {
		color: var(--text-muted);
	}

	.compact-list {
		display: grid;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.compact-list li {
		margin: 0;
		padding: 1rem;
	}

	.compact-list strong {
		display: block;
		font-size: 1rem;
		line-height: 1.35;
	}

	@media (max-width: 860px) {
		.hero,
		.latest-layout {
			grid-template-columns: 1fr;
		}

		.pillar-grid,
		.radar-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.home {
			width: min(100% - 1rem, var(--container));
		}
	}
</style>
