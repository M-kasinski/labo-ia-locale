---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const allPosts = (await getCollection('blog', ({ data }) => data.draft !== true)).sort(
	(a, b) =>
		b.data.pubDate.valueOf() - a.data.pubDate.valueOf() ||
		b.id.localeCompare(a.id),
);
const radarPosts = allPosts.filter((post) => post.data.tags.includes('radar-ia')).slice(0, 3);
const COLUMN_SIZE = 4;

const featured =
	allPosts.find((post) => post.data.featured === true) ?? allPosts[0];

const secondaryLocal = allPosts
	.filter(
		(post) =>
			post.data.category === 'local' &&
			post.id !== (featured.data.category === 'local' ? featured.id : ''),
	)
	.slice(0, COLUMN_SIZE);

const secondaryVeille = allPosts
	.filter(
		(post) =>
			post.data.category === 'veille' &&
			post.id !== (featured.data.category === 'veille' ? featured.id : ''),
	)
	.slice(0, COLUMN_SIZE);

const featuredBadge =
	featured.data.category === 'veille'
		? 'badge-veille'
		: featured.data.category === 'radar'
			? 'badge-veille'
			: 'badge-local';
const featuredBadgeLabel =
	featured.data.category === 'veille' || featured.data.category === 'radar'
		? 'Veille IA'
		: 'IA Locale';
---

<!doctype html>
<html lang="fr">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main class="home">
			<section class="hero" aria-labelledby="hero-title">
				<div>
					<p class="eyebrow">IA locale & veille générale — sans filtre</p>
					<h1 id="hero-title">Comprendre l'IA : du modèle local au paysage global.</h1>
					<p class="lede">{SITE_DESCRIPTION}</p>
					<div class="hero-actions">
						<a class="button" href="/blog/">Lire les articles</a>
						<a class="button-secondary" href="/about/">Notre ligne éditoriale</a>
					</div>
				</div>
				<aside class="terminal-card" aria-label="Résumé des sujets couverts">
					<div class="terminal-top"><span></span><span></span><span></span></div>
					<pre><code>$ labo --focus
local-llm
quantization
self-hosting
apple-silicon
foundation-models
scaling-laws
agents
sources: required</code></pre>
				</aside>
			</section>

			<section class="pillars" aria-labelledby="pillars-title">
				<p class="eyebrow">Le terrain</p>
				<h2 id="pillars-title">Deux univers, une même exigence.</h2>
				<div class="pillar-grid">
					<article class="card pillar">
						<h3>🔧 IA Locale</h3>
						<p>Faire tourner l'IA chez soi : modèles open-source, self-hosting, quantization, GPU & Apple Silicon. Tests et guides pratiques.</p>
						<a href="/blog/?category=local" class="pillar-link">Voir les articles →</a>
					</article>
					<article class="card pillar">
						<h3>📡 Veille IA</h3>
						<p>Les gros modèles, architectures et avancées majeures. Décryptages de l'actualité de l'IA générale sans se laisser aveugler par le buzz.</p>
						<a href="/blog/?category=veille" class="pillar-link">Voir les articles →</a>
					</article>
					<article class="card pillar">
						<h3>📝 Guides sourcés</h3>
						<p>Chaque article vise une décision concrète, avec sources en bas de page et limites explicites.</p>
					</article>
				</div>
			</section>

			{radarPosts.length > 0 && (
				<section class="radar" aria-labelledby="radar-title">
					<div class="section-heading">
						<p class="eyebrow">Radar IA</p>
						<h2 id="radar-title">Signaux courts à surveiller</h2>
						<p>Des brèves sourcées pour capter les annonces, rumeurs crédibles et mouvements de marché avant d'en faire un décryptage complet.</p>
					</div>
					<div class="radar-grid">
						{radarPosts.map((post) => (
							<article class="radar-card">
								<a href={`/blog/${post.id}/`}>
									<span class="radar-badge">Signal faible</span>
									<span class="radar-date"><FormattedDate date={post.data.pubDate} /></span>
									<h3>{post.data.title}</h3>
									<p>{post.data.description}</p>
								</a>
							</article>
						))}
					</div>
				</section>
			)}

			<section class="latest" aria-labelledby="latest-title">
				<div class="section-heading">
					<p class="eyebrow">Derniers articles</p>
					<h2 id="latest-title">Ce qui vient de sortir</h2>
				</div>

				{featured && (
					<article class="featured-card">
						<a href={`/blog/${featured.id}/`}>
							<span class={`category-badge ${featuredBadge}`}>{featuredBadgeLabel}</span>
							<span><FormattedDate date={featured.data.pubDate} /></span>
							<h3>{featured.data.title}</h3>
							<p>{featured.data.description}</p>
						</a>
					</article>
				)}

				<div class="two-columns">
					<div class="column local-column">
						<h3 class="column-title">
							<a href="/blog/?category=local">🔧 IA Locale</a>
						</h3>
						<ul class="compact-list">
							{secondaryLocal.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span><FormattedDate date={post.data.pubDate} /></span>
										<strong>{post.data.title}</strong>
									</a>
								</li>
							))}
						</ul>
					</div>

					<div class="column veille-column">
						<h3 class="column-title">
							<a href="/blog/?category=veille">📡 Veille IA</a>
						</h3>
						<ul class="compact-list">
							{secondaryVeille.map((post) => (
								<li>
									<a href={`/blog/${post.id}/`}>
										<span><FormattedDate date={post.data.pubDate} /></span>
										<strong>{post.data.title}</strong>
									</a>
								</li>
							))}
						</ul>
					</div>
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.home {
		width: min(var(--container), calc(100% - 2rem));
	}

	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
		align-items: center;
		gap: clamp(2rem, 6vw, 4rem);
		padding: clamp(2.5rem, 7vw, 6rem) 0 3rem;
	}

	.hero h1 {
		max-width: 900px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 1.6rem;
	}

	.terminal-card {
		border: 1px solid #263244;
		border-radius: var(--radius-lg);
		background: #111827;
		box-shadow: var(--shadow-soft);
		overflow: hidden;
	}

	.terminal-top {
		display: flex;
		gap: 0.45rem;
		border-bottom: 1px solid #263244;
		padding: 0.8rem 1rem;
	}

	.terminal-top span {
		width: 0.72rem;
		height: 0.72rem;
		border-radius: 999px;
		background: #8ee6d4;
		opacity: 0.78;
	}

	.terminal-top span:nth-child(2) {
		background: #f2c078;
	}

	.terminal-top span:nth-child(3) {
		background: #df8d8d;
	}

	.terminal-card pre {
		margin: 0;
		border: 0;
		border-radius: 0;
		box-shadow: none;
	}

	.pillars,
	.radar,
	.latest {
		margin-top: clamp(2.5rem, 7vw, 5rem);
	}

	.pillars > h2 {
		max-width: 720px;
	}

	.pillar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
		margin-top: 1.5rem;
	}

	.pillar {
		padding: 1.25rem;
	}

	.pillar h3 {
		font-size: 1.25rem;
		margin-bottom: 0.75rem;
	}

	.pillar p {
		margin-bottom: 0.75rem;
		color: var(--text-muted);
		font-size: 0.98rem;
	}

	.pillar-link {
		color: var(--accent);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
	}

	.pillar-link:hover {
		text-decoration: underline;
	}

	.section-heading {
		margin-bottom: 1.5rem;
	}

	.section-heading p:not(.eyebrow) {
		max-width: 760px;
		margin-top: 0.45rem;
		color: var(--text-muted);
	}

	.radar-grid {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 1rem;
	}

	.radar-card {
		border: 1px solid color-mix(in srgb, var(--accent) 52%, var(--border));
		border-radius: var(--radius-lg);
		background:
			linear-gradient(135deg, rgba(242, 192, 120, 0.2), transparent 48%),
			color-mix(in srgb, var(--surface) 90%, transparent);
		box-shadow: 0 14px 35px rgba(31, 28, 21, 0.055);
		padding: 1.15rem;
	}

	.radar-card a {
		color: inherit;
		text-decoration: none;
	}

	.radar-badge,
	.radar-date {
		display: inline-flex;
		margin: 0 0.55rem 0.75rem 0;
		font-family: var(--font-mono);
		font-size: 0.72rem;
		font-weight: 780;
		letter-spacing: 0.02em;
		text-transform: uppercase;
	}

	.radar-badge {
		border-radius: 999px;
		background: #111827;
		color: #f7e1b8;
		padding: 0.28rem 0.55rem;
	}

	.radar-date {
		color: var(--accent-dark);
	}

	.radar-card h3 {
		font-size: clamp(1.25rem, 2vw, 1.75rem);
	}

	.radar-card p {
		color: var(--text-muted);
	}

	.featured-card {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		padding: clamp(1.4rem, 4vw, 2rem);
		background:
			linear-gradient(135deg, rgba(216, 243, 238, 0.72), transparent 60%),
			var(--surface);
		margin-bottom: 2rem;
	}

	.featured-card a {
		color: inherit;
		text-decoration: none;
	}

	.category-badge {
		display: inline-block;
		padding: 0.25rem 0.6rem;
		border-radius: 999px;
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.03em;
		margin-right: 0.5rem;
	}

	.badge-local {
		background: rgba(142, 230, 212, 0.2);
		color: #8ee6d4;
	}

	.badge-veille {
		background: rgba(242, 192, 120, 0.2);
		color: #f2c078;
	}

	.featured-card span:not(.category-badge) {
		display: inline-block;
		margin-bottom: 0.65rem;
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 760;
	}

	.featured-card h3 {
		font-size: clamp(1.7rem, 4vw, 2.7rem);
		margin-top: 0.5rem;
	}

	.featured-card p {
		color: var(--text-muted);
		max-width: 800px;
	}

	.two-columns {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		margin-top: 1.5rem;
		align-items: start;
	}

	.column {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	.column-title {
		font-size: 1.1rem;
		margin-bottom: 1rem;
		padding-bottom: 0.75rem;
		border-bottom: 2px solid var(--border);
	}

	.column-title a {
		color: inherit;
		text-decoration: none;
		font-weight: 600;
	}

	.column-title a:hover {
		color: var(--accent);
	}

	.local-column .column-title {
		border-bottom-color: #8ee6d4;
	}

	.veille-column .column-title {
		border-bottom-color: #f2c078;
	}

	.compact-list {
		display: grid;
		gap: 0.75rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.compact-list li {
		border: 1px solid var(--border);
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--surface) 88%, transparent);
		padding: 1rem;
	}

	.compact-list a {
		color: inherit;
		text-decoration: none;
	}

	.compact-list span {
		display: inline-block;
		margin-bottom: 0.5rem;
		color: var(--accent-dark);
		font-family: var(--font-mono);
		font-size: 0.78rem;
		font-weight: 760;
	}

	.compact-list strong {
		display: block;
		font-size: 1rem;
		line-height: 1.35;
	}

	@media (max-width: 860px) {
		.hero,
		.two-columns {
			grid-template-columns: 1fr;
		}

		.pillar-grid,
		.radar-grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 720px) {
		.home {
			width: min(100% - 1rem, var(--container));
		}
	}
</style>
